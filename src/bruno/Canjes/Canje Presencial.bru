meta {
  name: Canje Presencial
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/canjes/presencial/:clienteId
  body: json
  auth: bearer
}

params:path {
  clienteId: {{clienteDemoId}}
}

auth:bearer {
  token: {{tokenEmpleado}}
}

body:json {
  {
    "beneficioId": "{{beneficioBaratoId}}"
  }
}

tests {
  test("201 Created: entregado en el momento (CU-11)", function () {
    expect(res.status).to.equal(201);
    expect(res.body.estado).to.equal("Entregado");
  });
}
