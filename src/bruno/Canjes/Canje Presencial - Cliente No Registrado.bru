meta {
  name: Canje Presencial - Cliente No Registrado
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/canjes/presencial
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpleado}}
}

body:json {
  {
    "clienteId": "00000000-0000-0000-0000-000000000000",
    "beneficioId": "{{beneficioBaratoId}}"
  }
}

tests {
  test("404 Not Found: el id no es de ningún cliente (CU-11, 1a)", function () {
    expect(res.status).to.equal(404);
  });
}
