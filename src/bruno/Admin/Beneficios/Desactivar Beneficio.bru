meta {
  name: Desactivar Beneficio
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/admin/beneficios/{{beneficioAdminId}}/desactivar
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
    expect(res.body.activo).to.equal(false);
  });
}
