meta {
  name: Crear Beneficio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/beneficios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "Beneficio Nuevo",
    "descripcion": "Creado desde Bruno",
    "costoPuntos": 200,
    "categoria": 0
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("beneficioAdminId", res.body.id);
  }
}

tests {
  test("201 Created", function () {
    expect(res.status).to.equal(201);
  });
}
