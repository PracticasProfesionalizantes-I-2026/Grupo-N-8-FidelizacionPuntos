meta {
  name: Listar Categorias
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/admin/beneficios/categorias
  body: none
  auth: inherit
}

docs {
  Categorías válidas para crear o modificar un beneficio: el `id` es el número que se envía en
  `categoria` (1 = Descuento, 2 = Producto gratis, 3 = Experiencia, 4 = Otro).
}

tests {
  test("200 OK con las categorías numeradas desde 1 (CU-17)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items[0].id).to.equal(1);
    expect(res.body.items.length).to.equal(4);
  });
}
