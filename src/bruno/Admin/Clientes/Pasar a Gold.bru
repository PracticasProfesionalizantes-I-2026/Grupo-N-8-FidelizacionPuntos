meta {
  name: Pasar a Gold
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/admin/clientes/{{clienteAdminId}}
  body: json
  auth: inherit
}

body:json {
  {
    "categoria": 2
  }
}

tests {
  test("200 OK: categoría Gold (N1)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.categoria).to.equal(2); // 1 = Estándar, 2 = Gold
  });
}
