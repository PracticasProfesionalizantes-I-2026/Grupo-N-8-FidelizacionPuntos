meta {
  name: Listar Empleados
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/empleados
  body: none
  auth: inherit
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("forma común de los listados: { mensaje, items } (CU-16)", function () {
    expect(res.body).to.have.property("mensaje");
    expect(res.body.items).to.be.an("array");
  });
}
