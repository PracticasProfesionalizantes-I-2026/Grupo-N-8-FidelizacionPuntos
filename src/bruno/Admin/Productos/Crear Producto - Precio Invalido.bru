meta {
  name: Crear Producto - Precio Invalido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/productos
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Producto Precio Invalido",
    "descripcion": "Creado desde Bruno",
    "precio": 0
  }
  
}

tests {
  test("400 Bad Request", function () {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
