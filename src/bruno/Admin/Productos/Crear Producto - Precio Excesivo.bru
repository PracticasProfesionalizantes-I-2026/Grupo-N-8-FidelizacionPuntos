  auth: inherit
}

body:json {
  {
    "nombre": "Producto Muy Caro",
    "precio": 1000000
  }
}

tests {
  test("400 Bad Request", function () {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
