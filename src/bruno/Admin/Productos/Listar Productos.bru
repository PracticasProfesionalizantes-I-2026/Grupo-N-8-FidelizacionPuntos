meta {
  name: Listar Productos
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/admin/productos
  body: none
  auth: inherit
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });
  test("Incluye productos desactivados", function () {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.some(p => p.activo === false)).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
