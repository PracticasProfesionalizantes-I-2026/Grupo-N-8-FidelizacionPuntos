meta {
  name: Actualizar Regla
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/admin/reglas-acumulacion/{{reglaAdminId}}
  body: json
  auth: inherit
}

body:json {
  {
    "puntosPorMonto": 0.5
  }
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
    expect(res.body.puntosPorMonto).to.equal(0.5);
    expect(res.body.fechaModificacion).to.not.equal(null);
  });
}
