meta {
  name: Listar Reglas
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/reglas-acumulacion
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setVar("reglaAcumulacionId", res.body[0].id);
  }
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });
}
