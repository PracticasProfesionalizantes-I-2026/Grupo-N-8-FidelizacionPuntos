meta {
  name: Consultar Movimientos Con Filtros
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/movimientos?tipoMovimiento=Acumulacion&fechaDesde=2026-01-01
  auth: bearer
}

params:query {
  tipoMovimiento: Acumulacion
  fechaDesde: 2026-01-01
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
  });
}
