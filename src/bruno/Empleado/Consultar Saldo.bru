meta {
  name: Consultar Saldo
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/clientes/{{clienteDemoId}}/saldo
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpleado}}
}

tests {
  test("200 OK con el saldo vigente del cliente demo (150)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.puntosDisponibles).to.equal(150);
  });
}
