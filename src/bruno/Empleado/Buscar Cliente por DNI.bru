meta {
  name: Buscar Cliente por DNI
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/clientes?documento=40333444
  body: none
  auth: bearer
}

params:query {
  documento: 40333444
}

auth:bearer {
  token: {{tokenEmpleado}}
}

docs {
  El empleado busca al cliente por DNI y obtiene su id; con ese id registra la compra (CU-10),
  el canje presencial (CU-11) o consulta sus canjes (CU-13). También lo puede usar el admin.
}

tests {
  test("200 OK con el id del cliente (punto de venta)", function () {
    expect(res.status).to.equal(200);
    // El id es un número y las variables del entorno son texto: se comparan como texto.
    expect(String(res.body.id)).to.equal(bru.getEnvVar("clienteDemoId"));
    expect(res.body.documento).to.equal("40333444");
  });

  test("respuesta reducida: sin email ni teléfono", function () {
    expect(res.body).to.not.have.property("email");
    expect(res.body).to.not.have.property("telefono");
  });
}
