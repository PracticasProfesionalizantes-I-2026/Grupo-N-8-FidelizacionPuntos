meta {
  name: Buscar Cliente por DNI - No Encontrado
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/clientes?documento=99999999
  body: none
  auth: bearer
}

params:query {
  documento: 99999999
}

auth:bearer {
  token: {{tokenEmpleado}}
}

tests {
  test("404 Not Found: el DNI no está registrado", function () {
    expect(res.status).to.equal(404);
  });

  test("el error es un ErrorResponseDTO: { mensaje }", function () {
    expect(res.body.mensaje).to.be.a("string");
    expect(res.body).to.not.have.property("message");
  });
}
