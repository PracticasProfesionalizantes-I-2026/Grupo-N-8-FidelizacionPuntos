meta {
  name: Consultar Beneficios Activos
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/beneficios
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

script:post-response {
  if (res.status === 200) {
    const descuento = res.body.find(b => b.nombre === "Descuento 10%");
    if (descuento) bru.setVar("beneficioIdDescuento", descuento.id);

    const costoAlto = res.body.find(b => b.nombre.startsWith("Beneficio Costo Alto"));
    if (costoAlto) bru.setVar("beneficioIdCostoAlto", costoAlto.id);
  }
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}
