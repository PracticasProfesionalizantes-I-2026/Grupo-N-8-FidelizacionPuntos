meta {
  name: Actualizar Perfil
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/clientes/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "telefono": "1166778899"
  }
}

tests {
  test("200 OK", function () {
    expect(res.status).to.equal(200);
    expect(res.body.telefono).to.equal("1166778899");
  });
}
