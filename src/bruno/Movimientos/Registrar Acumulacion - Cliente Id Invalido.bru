meta {
  name: Registrar Acumulacion - Cliente Id Invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/movimientos/acumulaciones/:clienteId
  body: json
  auth: inherit
}

params:path {
  clienteId: abc123
}

body:json {
  {
    "items": [
      { "productoId": "{{productoCompraId}}", "cantidad": 2 }
    ]
  }
}

tests {
  test("404 Not Found: clienteId no es un Guid, la ruta {clienteId:guid} no coincide (CU-10)", function () {
    expect(res.status).to.equal(404);
  });
}
