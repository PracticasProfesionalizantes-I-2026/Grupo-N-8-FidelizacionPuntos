meta {
  name: Registrar Acumulacion - Cliente No Registrado
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/movimientos/acumulaciones/:clienteId
  body: json
  auth: inherit
}

params:path {
  clienteId: 2147483647
}

body:json {
  {
    "items": [
      { "productoId": {{productoCompraId}}, "cantidad": 2 }
    ]
  }
}

tests {
  test("404 Not Found: el id no es de ningún cliente (CU-10, 3a)", function () {
    expect(res.status).to.equal(404);
  });
}
