meta {
  name: Registrar Acumulacion - Cliente No Registrado
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/movimientos/acumulaciones
  body: json
  auth: inherit
}

body:json {
  {
    "clienteDocumento": "99999999",
    "items": [
      { "productoId": "{{productoCompraId}}", "cantidad": 2 }
    ]
  }
}

tests {
  test("404 Not Found", function () {
    expect(res.status).to.equal(404);
  });
}
