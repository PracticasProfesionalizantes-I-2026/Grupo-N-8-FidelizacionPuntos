meta {
  name: Registrar Acumulacion
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/movimientos/acumulaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpleado}}
}

body:json {
  {
    "clienteDocumento": "40333444",
    "items": [
      { "producto": "Producto Demo A", "cantidad": 1, "monto": 2000 }
    ]
  }
}

docs {
  Correr antes de "Canjes/Crear Canje Cliente" para asegurar saldo suficiente.
}

tests {
  test("201 Created", function () {
    expect(res.status).to.equal(201);
  });
}
