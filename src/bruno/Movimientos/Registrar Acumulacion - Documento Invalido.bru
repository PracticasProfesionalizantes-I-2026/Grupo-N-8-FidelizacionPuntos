meta {
  name: Registrar Acumulacion - Cliente Id Invalido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/movimientos/acumulaciones
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": "abc123",
    "items": [
      { "productoId": "{{productoCompraId}}", "cantidad": 2 }
    ]
  }
}

tests {
  test("400 Bad Request: clienteId no es un Guid (CU-10, 2a)", function () {
    expect(res.status).to.equal(400);
  });
}
