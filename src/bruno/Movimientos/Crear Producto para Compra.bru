meta {
  name: Crear Producto para Compra
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/productos
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Combo {{$randomInt}}",
    "descripcion": "Producto para probar la acumulación",
    "precio": 1000
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("productoCompraId", res.body.id);
  }
}

tests {
  test("201 Created", function () {
    expect(res.status).to.equal(201);
  });
}
