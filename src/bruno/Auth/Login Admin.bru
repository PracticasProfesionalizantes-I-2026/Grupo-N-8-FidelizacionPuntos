meta {
  name: Login Admin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/admin/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "admin@fidelix.local",
    "password": "Admin123!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenAdmin", res.body.token);
  }
}

tests {
  test("200 OK y guarda el token de admin (CU-14)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.rol).to.equal("Admin");
  });
}
