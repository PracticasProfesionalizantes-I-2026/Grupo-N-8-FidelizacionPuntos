meta {
  name: Login Empleado
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "empleado.demo@fidelix.local",
    "password": "Empleado123!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenEmpleado", res.body.token);
  }
}

tests {
  test("200 OK con token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.rol).to.equal(1); // RolUsuario.Empleado
  });
}
