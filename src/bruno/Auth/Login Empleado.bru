meta {
  name: Login Empleado
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/empleados/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "empleado@fidelix.local",
    "password": "Empleado123!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenEmpleado", res.body.token);
  }
}

tests {
  test("200 OK y guarda el token de empleado (CU-09)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.rol).to.equal("Empleado");
  });
}
