meta {
  name: Login Cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "cliente.demo@fidelix.local",
    "password": "Cliente123!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("tokenCliente", res.body.token);
  }
}

tests {
  test("200 OK", function (){
       expect(res.status).to.equal(200);
  });
  test("Devuelve el token", function (){
    expect(res.body.token).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
