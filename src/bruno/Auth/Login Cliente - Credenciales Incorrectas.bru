meta {
  name: Login Cliente - Credenciales Incorrectas
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "no.existe@fidelix.local",
    "password": "NoExiste123!"
  }
}

tests {
  test("401 Unauthorized", function (){
    expect(res.status).to.equal(401);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
