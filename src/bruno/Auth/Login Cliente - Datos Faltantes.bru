meta {
  name: Login Cliente - Datos Faltantes
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "cliente.demo@fidelix.local"
  }
}

tests {
  test("400 Bad Request", function (){
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
